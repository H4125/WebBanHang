@model IEnumerable<WebBanHang.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
}
<div class="container" style="margin-top: 20px;">
    <div class="p-5 text-center bg-danger text-white rounded mb-4">
        <h1>Chào mừng đến với cửa hàng của chúng tôi!</h1>
        <p>Khám phá các sản phẩm công nghệ và thiết bị mới nhất với giá tốt nhất.</p>
    </div>

<h2 class="text-center my-4">Danh Sách Sản Phẩm</h2>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm">
                <img src="@item.Picture" class="card-img-top" alt="@item.ProductName" style="height: 200px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.ProductName</h5>
                    <p class="card-text text-muted mb-1">Mã SP: @item.ProductCode</p>
                    <p class="card-text text-danger fw-bold">Giá: @item.UnitPrice.ToString("N0") đ</p>

                    <a href="/Cart/AddToCart?productId=@item.Id" class="btn btn-primary mt-auto">Thêm vào giỏ</a>
                </div>
            </div>
        </div>
    }
</div>