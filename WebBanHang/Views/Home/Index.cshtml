@model IEnumerable<WebBanHang.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container" style="margin-top: 20px;">
    <!-- Banner hiện tại của nhóm -->
    <div class="p-5 text-center bg-danger text-white rounded mb-4">
        <h1>Chào mừng đến với cửa hàng của chúng tôi!</h1>
        <p>Khám phá các sản phẩm công nghệ và thiết bị mới nhất với giá tốt nhất.</p>
    </div>

    <!-- KHU VỰC THANH TÌM KIẾM VÀ BỘ LỌC -->
    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
            <form asp-controller="Home" asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <input type="text" name="searchString" class="form-control" placeholder="Tìm tên sản phẩm..." value="@ViewBag.SearchString" />
                </div>
                <div class="col-md-3">
                    <select name="catalogId" class="form-select" asp-items="@ViewBag.CatalogList">
                        <option value="">-- Tất cả danh mục --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="number" name="minPrice" class="form-control" placeholder="Giá từ..." value="@ViewBag.MinPrice" />
                </div>
                <div class="col-md-2">
                    <input type="number" name="maxPrice" class="form-control" placeholder="Đến giá..." value="@ViewBag.MaxPrice" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
                </div>
            </form>
        </div>
    </div>
    <!-- KẾT THÚC BỘ LỌC -->

    <h2 class="text-center mb-4">Danh Sách Sản Phẩm</h2>

    <!-- KIỂM TRA DỮ LIỆU -->
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            Không tìm thấy sản phẩm nào phù hợp với điều kiện tìm kiếm của bạn.
        </div>
    }
    else
    {
        <!-- VÒNG LẶP SẢN PHẨM -->
        <div class="row">
            @foreach (var item in Model)
            {
                <!-- Dùng col-lg-3 và col-md-4 để màn máy tính hiện 4 SP, màn ipad hiện 3 SP -->
                <div class="col-6 col-md-4 col-lg-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@item.Picture" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@item.ProductName" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-truncate" title="@item.ProductName">@item.ProductName</h5>
<p class="card-text text-muted mb-1">Mã SP: @(item.ProductCode ?? "SP0" + item.Id)</p>
                            <p class="card-text text-danger fw-bold">Giá: @item.UnitPrice.ToString("N0") đ</p>
                            
                            <!-- mt-auto giúp đẩy nút luôn nằm ở dưới cùng của thẻ card -->
                            <a href="/Cart/AddToCart?productId=@item.Id" class="btn btn-primary w-100 mt-auto">Thêm vào giỏ</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- THANH CHUYỂN TRANG (PAGINATION) -->
    @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
    {
        <!-- Tạo biến lưu trữ tham số truy vấn hiện tại để giữ nguyên bộ lọc khi chuyển trang -->
        var queryParams = $"&searchString={ViewBag.SearchString}&catalogId={Context.Request.Query["catalogId"]}&minPrice={ViewBag.MinPrice}&maxPrice={ViewBag.MaxPrice}";

        <nav aria-label="Page navigation" class="mt-5 mb-4">
            <ul class="pagination justify-content-center">
                
                <!-- Nút 'Trang trước' -->
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="/Home/Index?page=@(ViewBag.CurrentPage - 1)@queryParams">« Trước</a>
                </li>

                <!-- Các số trang (1, 2, 3...) -->
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="/Home/Index?page=@i@queryParams">@i</a>
                    </li>
                }

                <!-- Nút 'Trang sau' -->
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="/Home/Index?page=@(ViewBag.CurrentPage + 1)@queryParams">Sau »</a>
                </li>

            </ul>
        </nav>
    }
</div>
