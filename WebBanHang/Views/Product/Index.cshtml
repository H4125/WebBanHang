@model IEnumerable<WebBanHang.Models.Product>
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="container mt-4">
    <h2>Quản lý Sản Phẩm</h2>
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">Thêm sản phẩm mới</a>
        <a asp-action="SapXepSanPhamTheoDonGia" class="btn btn-outline-info">Sắp xếp theo Giá</a>
        <a asp-action="LayToanBo_Sp" class="btn btn-outline-secondary">Gọi Proc Tất cả SP</a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Ảnh</th>
                <th>Mã SP</th>
                <th>Tên SP</th>
                <th>Danh mục</th>
                <th>Đơn giá</th>
                <th>Tồn kho</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><img src="@item.Picture" alt="Ảnh SP" width="60" height="60" style="object-fit:cover" /></td>
                    <td>@item.ProductCode</td>
                    <td>@item.ProductName</td>
                    <td>@(item.Catalog != null ? item.Catalog.CatalogName : "N/A")</td>
                    <td>@String.Format("{0:N0}", item.UnitPrice) đ</td>
                    <td>@item.Quantity</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Xóa sản phẩm này?');">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>