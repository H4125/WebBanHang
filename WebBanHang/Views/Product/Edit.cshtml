@model WebBanHang.Models.Product
@{
    ViewData["Title"] = "Sửa Sản Phẩm";
}

<div class="container mt-4">
    <h2>Cập nhật Sản Phẩm</h2>
    <hr />
    <div class="row">
        <div class="col-md-8">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <!-- Giữ lại ảnh cũ nếu user không upload ảnh mới -->
                <input type="hidden" asp-for="Picture" />

                <div class="mb-3">
                    <label asp-for="CatalogId" class="form-label">Danh mục:</label>
                    <select asp-for="CatalogId" asp-items="ViewBag.CatalogId" class="form-control"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductCode" class="form-label">Mã SP:</label>
                    <input asp-for="ProductCode" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label">Tên sản phẩm:</label>
                    <input asp-for="ProductName" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="UnitPrice" class="form-label">Đơn giá:</label>
                    <input asp-for="UnitPrice" type="number" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label">Tồn kho:</label>
                    <input asp-for="Quantity" type="number" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Ảnh hiện tại:</label><br />
                    <img src="@Model.Picture" width="100" class="mb-2" />
                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    <small class="text-muted">Bỏ trống nếu không muốn thay đổi ảnh.</small>
                </div>

                <button type="submit" class="btn btn-success">Cập nhật</button>
                <a asp-action="Index" class="btn btn-secondary">Quay về</a>
            </form>
        </div>
    </div>
</div>