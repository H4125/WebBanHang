@model IEnumerable<WebBanHang.Models.OrderDetail>
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<h2 class="mt-4 text-info">Chi tiết đơn hàng #@ViewBag.OrderId</h2>
<hr />

<table class="table table-striped table-bordered mt-3">
    <thead class="table-dark">
        <tr>
            <th>Mã Sản Phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @{
            decimal totalAmount = 0;
        }
        @foreach (var item in Model)
        {
            var lineTotal = item.Quantity * item.UnitPrice;
            totalAmount += lineTotal;
            <tr>
                <td>SP_@item.ProductId</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0") VNĐ</td>
                <td class="fw-bold text-danger">@lineTotal.ToString("N0") VNĐ</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
            <td class="fw-bold text-danger fs-5">@totalAmount.ToString("N0") VNĐ</td>
        </tr>
    </tfoot>
</table>

<a href="javascript:history.back()" class="btn btn-secondary">Quay lại</a>