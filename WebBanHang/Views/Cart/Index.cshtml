@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
}

@model IEnumerable<WebBanHang.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ Hàng";
}

<h2 class="mt-4 mb-4">Giỏ hàng của bạn</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Giỏ hàng đang trống.</div>
    <a href="/" class="btn btn-outline-primary">Tiếp tục mua sắm</a>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <!-- 1. Cột Hình ảnh -->
            <td>
                        <img src="@item.Picture" style="max-width: 80px;" alt="Ảnh sản phẩm" />
            </td>
            
            <!-- 2. Cột Tên sản phẩm -->
            <td>@item.ProductName</td>
            
            <!-- 3. Cột Đơn giá -->
            <td>@item.UnitPrice.ToString("N0") đ</td>
            
            <!-- 4. Cột Số lượng (chứa form cập nhật) -->
            <td>
                <form action="/Cart/UpdateCart" method="post" class="d-flex">
                    <input type="hidden" name="productId" value="@item.ProductId" />
                    <input type="number" name="quantity" value="@item.Quantity" class="form-control me-2" style="width: 80px;" min="1" />
                    <button type="submit" class="btn btn-success btn-sm">Cập nhật</button>
                </form>
            </td>
            
            <!-- 5. Cột Thành tiền -->
            <td class="fw-bold text-danger">@item.TotalPrice.ToString("N0") đ</td>
            
            <!-- 6. Cột Thao tác -->
            <td>
                <a href="/Cart/RemoveCart?productId=@item.ProductId" class="btn btn-sm btn-danger">Xóa</a>
            </td>
        </tr>
    }
</tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h4>Tổng tiền: <span class="text-danger fw-bold">@ViewBag.TotalAmount.ToString("N0") đ</span></h4>
        <div>
            <a href="/" class="btn btn-secondary me-2" >Tiếp tục mua sắm</a>
            <a href="/Cart/Checkout" class="btn btn-info text-white">Tiến hành Thanh toán</a>
        </div>
    </div>
}