@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
}

@model IEnumerable<WebBanHang.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ Hàng";
}

<h2 class="mt-4 mb-4">Giỏ hàng của bạn</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">Giỏ hàng đang trống.</div>
    <a href="/" class="btn btn-outline-primary">Tiếp tục mua sắm</a>
}
else
{
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><img src="@item.Picture" alt="@item.ProductName" style="width: 80px;" /></td>
                    <td>@item.ProductName</td>
                    <td>@item.UnitPrice.ToString("N0") đ</td>
                    <td>
                        <form asp-action="UpdateCart" asp-controller="Cart" method="post" class="d-flex">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control me-2" style="width: 80px;" />
                            <button type="submit" class="btn btn-sm btn-success">Cập nhật</button>
                        </form>
                    </td>
                    <td class="fw-bold">@item.TotalPrice.ToString("N0") đ</td>
                    <td>
                        <a href="/Cart/RemoveCart?productId=@item.ProductId" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <h4>Tổng tiền: <span class="text-danger fw-bold">@ViewBag.Total.ToString("N0") đ</span></h4>
        <div>
            <a href="/" class="btn btn-secondary me-2">Tiếp tục mua sắm</a>
            <a href="/Cart/Checkout" class="btn btn-info text-white">Thanh toán COD</a>
            <a href="/Cart/PaymentWithVNPay" class="btn btn-primary">Thanh toán VNPay</a>
        </div>
    </div>
}