@model IEnumerable<WebBanHang.Models.Brand>
@{
    ViewData["Title"] = "Quản lý Phân loại";
}

<div class="container mt-4">
    <h2 class="mb-4">Quản Lý Phân Loại Sản Phẩm</h2>

    <!-- THANH ĐIỀU HƯỚNG TABS -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <!-- Link trỏ về trang Danh mục -->
            <a class="nav-link text-secondary" asp-controller="Catalog" asp-action="Index">
               Loại thiết bị (Danh mục)
            </a>
        </li>
        <li class="nav-item">
            <!-- Đang ở trang Brand nên tab này sáng lên (active) -->
            <a class="nav-link active fw-bold" asp-controller="Brand" asp-action="Index">
               Hãng sản xuất
            </a>
        </li>
    </ul>

    <!-- KHU VỰC NỘI DUNG -->
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">+ Thêm Hãng mới</a>
    </div>
    
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tên Hãng</th>
                <th style="width: 150px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><span class="badge bg-secondary" style="font-size: 14px;">@item.BrandName</span></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?');">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>