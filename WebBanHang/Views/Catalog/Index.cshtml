@model IEnumerable<WebBanHang.Models.Catalog>
@{
    ViewData["Title"] = "Quản lý Phân loại";
}

<div class="container mt-4">
    <h2 class="mb-4">Quản Lý Phân Loại Sản Phẩm</h2>

    <!-- THANH ĐIỀU HƯỚNG TABS -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <!-- Đang ở trang Catalog nên tab này sáng lên (active) -->
            <a class="nav-link active fw-bold" asp-controller="Catalog" asp-action="Index">
                Loại thiết bị (Danh mục)
            </a>
        </li>
        <li class="nav-item">
            <!-- Link trỏ sang trang Quản lý Hãng -->
            <a class="nav-link text-secondary" asp-controller="Brand" asp-action="Index">
                Hãng sản xuất
            </a>
        </li>
    </ul>

    <!-- KHU VỰC NỘI DUNG -->
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">+ Thêm danh mục mới</a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Mã Danh Mục</th>
                <th>Tên Danh Mục</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.CatalogCode</td>
                    <td>@item.CatalogName</td>
                    <td>
                        <a asp-action="SanPhams" asp-route-catalogId="@item.Id" class="btn btn-info btn-sm">Xem SP</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?');">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>