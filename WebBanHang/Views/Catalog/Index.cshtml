@model IEnumerable<WebBanHang.Models.Catalog>
@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="container mt-4">
    <h2>Quản lý Danh mục</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Thêm danh mục mới</a>
    </p>
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Mã Danh Mục</th>
                <th>Tên Danh Mục</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.CatalogCode</td>
                    <td>@item.CatalogName</td>
                    <td>
                        <a asp-action="SanPhams" asp-route-catalogId="@item.Id" class="btn btn-info btn-sm">Xem SP</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa?');">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>