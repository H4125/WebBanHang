@model IEnumerable<WebBanHang.Models.Catalog>
@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="d-flex justify-content-between align-items-center mt-4">
    <h2 class="text-primary">Quản lý Danh Mục</h2>
    <a href="/Catalog/Create" class="btn btn-success"><i class="fas fa-plus"></i> Thêm danh mục mới</a>
</div>
<hr />

<table class="table table-bordered table-hover mt-3">
    <thead class="table-light">
        <tr>
            <th>Mã Danh Mục</th>
            <th>Tên Danh Mục</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">@item.CatalogCode</td>
                <td>@item.CatalogName</td>
            </tr>
        }
    </tbody>
</table>